LOAD DATABASE
    FROM mssql://fleury:NouveauMotDePasse123!@sqlserver-host/OpenIsta
    INTO postgresql://fleury:NouveauMotDePasse123@localhost/openista

WITH include drop, create tables, create indexes, reset sequences, foreign keys,
     workers = 8, concurrency = 2

CAST type datetime to timestamptz,
     type datetime2 to timestamptz,
     type decimal to numeric,
     type nvarchar to varchar,
     type bit to boolean,
     type text to text,
     type image to bytea;