# Configuration de base (gardez vos valeurs actuelles)
SECRET_KEY=ton_secret_key_ici
FLASK_DEBUG=true
FLASK_ENV=development

# Ancienne configuration MySQL (à garder pour la migration)
MYSQL_HOST=127.0.0.1
MYSQL_USER=fleury
MYSQL_PASSWORD=NouveauMotDePasse123!
MYSQL_DATABASE=OpenIsta
OLD_DATABASE_URL=mysql+pymysql://fleury:NouveauMotDePasse123!@127.0.0.1/OpenIsta?charset=utf8mb4

# Nouvelle configuration PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=fleury
POSTGRES_PASSWORD=NouveauMotDePasse123
POSTGRES_DATABASE=openista
DATABASE_URL=postgresql://fleury:NouveauMotDePasse123@127.0.0.1:5432/openista

# Environnements PostgreSQL
DEV_DATABASE_URL=postgresql://fleury:NouveauMotDePasse123@127.0.0.1:5432/openista_dev
TEST_DATABASE_URL=postgresql://fleury:NouveauMotDePasse123@127.0.0.1:5432/openista_test

# Configuration Email (gardez vos valeurs)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=votre.email@openista.com
MAIL_PASSWORD=votre-mot-de-passe-email
