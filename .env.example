# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais versionner .env.

# Obligatoire en production. Générer avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development (par défaut) | production
APP_ENV=development

# Base de données. Vide = SQLite dans instance/ista.sqlite (développement).
# Production : postgresql://utilisateur:motdepasse@hote:5432/ista
DATABASE_URL=

# Utilisé par docker-compose.yml pour la base PostgreSQL
POSTGRES_PASSWORD=

# Dossier des fichiers déposés (cours, pièces jointes...). Vide = instance/uploads
UPLOAD_FOLDER=
# Taille maximale d'un envoi, en Mo
MAX_UPLOAD_MB=20

# Inscription libre des étudiants (les comptes restent à valider par l'administration)
ALLOW_SELF_REGISTRATION=false

# Note minimale sur 20 pour valider un cours (à confirmer par l'ISTA)
PASS_MARK=10

# Mettre à false uniquement si l'application est servie sans HTTPS (déconseillé)
COOKIE_SECURE=true

# Charger les données de démonstration au démarrage du conteneur
SEED_DEMO=false

# Notifications push (facultatif). Générer avec : flask push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:contact@exemple.bi
