# Flask
SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=false
FLASK_ENV=development

# Database (SQLite is suitable for local development; use PostgreSQL in production)
DATABASE_URL=sqlite:///instance/openista.sqlite
DEV_DATABASE_URL=
TEST_DATABASE_URL=sqlite:///:memory:

# Legacy database migration settings (only if a migration is explicitly required)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
OLD_DATABASE_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Email (optional for password reset)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.invalid

# Token signing
SECURITY_PASSWORD_SALT=replace-with-another-random-secret
